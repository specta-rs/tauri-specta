{
  // Type-checks the committed TypeScript fixtures in `tests/snapshots/*_ts/` and the
  // compile-time assertions in this directory (e.g. `tauri-events.ts`).
  // The JSDoc fixtures are mostly excluded: they only type-check under `--checkJs`, and
  // carry pre-existing diagnostics unrelated to the generated runtime. `tsconfig.jsdoc.json`
  // checks the parts of that surface this repo added and can vouch for.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "types": []
  },
  "include": ["../snapshots/*_ts/**/*.ts", "*.ts"]
}
