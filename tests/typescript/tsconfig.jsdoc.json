{
  // Type-checks the JSDoc fixtures this repo added and can vouch for, under `checkJs`:
  // the built-in event fixtures and the probes next to this file (`jsdoc-mocks.js` for
  // the mocks runtime, `tauri-events.js` for the event accessors). `allowJs`/`checkJs`
  // are what makes the emitter's `@type` comments matter at all.
  //
  // The remaining JSDoc fixtures carry pre-existing diagnostics unrelated to these
  // additions (e.g. in the `typedError` runtime and the `Files` layout), so they stay out.
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "../snapshots/semantic_channels_jsdoc/bindings.js",
    "jsdoc-mocks.js",
    "tauri-events.js"
  ]
}
