{
  // Type-checks the JSDoc fixtures this repo added and can vouch for, under `checkJs`:
  // the built-in event fixtures and the probes next to this file (`jsdoc-mocks.js` for
  // the mocks runtime, `tauri-events.js` for the event accessors). `allowJs`/`checkJs`
  // are what makes the emitter's `@type` comments matter at all.
  //
  // The `Files` layout and `DataError` fixture still have unrelated diagnostics.
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "../snapshots/error_result_jsdoc/bindings.js",
    "../snapshots/semantic_channels_jsdoc/bindings.js",
    "event-phases.js",
    "jsdoc-mocks.js",
    "tauri-events.js"
  ]
}
